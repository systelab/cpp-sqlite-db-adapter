def version = "0.0.0"
def packageName = "db-sqlite-adapter"
def profile = "vs2022.conanprofile"
def arch = "x86"
def configs = ['Debug', 'Release']

@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'snow-lib-build'
	}

	environment
	{
		PATH = "C:\\Users\\jenkins\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'version',
				description: 'Number of the version to build (must match the name of the tag that will be checked out), leave as 0.0.0 for checkout of current branch',
				defaultValue: '0.0.0' )

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				script 
				{
					if (params.version == '0.0.0')
					{
						checkoutSourceCode()
					}
					else
					{
						checkoutSourceCodeFromTag(version)
						version = params.version
					}
				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					configs.each
					{ config -> 
						stage("Build ${config}|${arch}")
						{
							def reportsFolder = "${env.WORKSPACE}/test_reports/${config}-${arch}/"
							withEnv(["GTEST_OUTPUT=xml:${reportsFolder}"])
							{
								bat script: "conan create . --version ${version} --profile:all ${profile} -s:h build_type=${config} -s:h arch=${arch} --build=missing", label: "Creating package ${packageName}/${version} (${config}|${arch})"
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				bat script: "conan upload ${packageName}/${version} -r aid-conan-production-local --confirm --force", label: "Uploading packages for ${packageName}/${version}"
			}
		}
	}

	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "test_reports/**/*.xml"
			script
			{
				currentBuild.description = "${version}"
			}
		}
	}
}
